{
  "name": "noxvault-bot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "description": "Read-only Telegram notification bot for Noxvault vaults",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dry-run": "tsc -p tsconfig.json && node dist/dry-run.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  }
}
